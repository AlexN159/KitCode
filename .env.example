# Optional AI coach. The in-app setup wizard can write these local settings.
# Never commit real keys; .env is ignored by git but plaintext to your Windows user account.
# A pasted key goes once to the local 127.0.0.1 backend, is never returned to the UI,
# and is later used only as authentication with the selected provider.
OPENAI_API_KEY=
KITCODE_OPENAI_MODEL=gpt-5.6-terra
# OpenAI choices: gpt-5.6-terra, gpt-5.6-luna, gpt-5.6-sol; optionally gpt-5.4-mini if available.

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# Anthropic choices: claude-sonnet-5, claude-haiku-4-5, claude-opus-5

# Optional local model server (no API key is forwarded).
# The in-app detector checks whether the base URL responds; enter a model ID to use it.
KITCODE_LOCAL_LLM_URL=http://127.0.0.1:5000/
KITCODE_LOCAL_LLM_MODEL=

# Optional: openai, anthropic, codex, or local_llm. Blank prefers a configured API;
# select Codex or a local LLM explicitly (or use its detector) so clearing AI
# setup does not silently reactivate an installed service.
KITCODE_COACH_PROVIDER=

# Optional runtime settings
KITCODE_PORT=8765
KITCODE_OPEN_BROWSER=1
